+inline void ggml_vk_get_physical_device_features2(VkPhysicalDevice physicalDevice, VkPhysicalDeviceFeatures2 * pFeatures) {
+    if (VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceProperties2 != nullptr &&
+        VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceProperties2 != &ggml_vk_get_physical_device_properties2_hook) {
+        ggml_vk_real_get_props2() = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceProperties2;
+        VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceProperties2 = &ggml_vk_get_physical_device_properties2_hook;
+    }
+
+    VkPhysicalDeviceVulkan11Features * vk11_features = nullptr;
+    VkPhysicalDeviceVulkan12Features * vk12_features = nullptr;
+    for (VkBaseOutStructure * cur = reinterpret_cast<VkBaseOutStructure *>(pFeatures->pNext); cur != nullptr; cur = cur->pNext) {
+        if (cur->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES) {
+            vk11_features = reinterpret_cast<VkPhysicalDeviceVulkan11Features *>(cur);
+            void * next = vk11_features->pNext;
+            *vk11_features = VkPhysicalDeviceVulkan11Features{};
+            vk11_features->sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES;
+            vk11_features->pNext = next;
+        } else if (cur->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES) {
+            vk12_features = reinterpret_cast<VkPhysicalDeviceVulkan12Features *>(cur);
+            void * next = vk12_features->pNext;
+            *vk12_features = VkPhysicalDeviceVulkan12Features{};
+            vk12_features->sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
+            vk12_features->pNext = next;
+        } else if (cur->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COOPERATIVE_MATRIX_FEATURES_KHR) {
+            auto * cm = reinterpret_cast<VkPhysicalDeviceCooperativeMatrixFeaturesKHR *>(cur);
+            cm->cooperativeMatrix = VK_FALSE;
+            cm->cooperativeMatrixRobustBufferAccess = VK_FALSE;
+        }
+    }
+
+    ::vkGetPhysicalDeviceFeatures2(physicalDevice, pFeatures);
+
+    VkPhysicalDeviceProperties props{};
+    ::vkGetPhysicalDeviceProperties(physicalDevice, &props);
+
+    static thread_local VkPhysicalDevice16BitStorageFeatures tl_storage16{};
+    static thread_local VkPhysicalDeviceShaderFloat16Int8Features tl_f16i8{};
+
+    if (vk11_features != nullptr && !vk11_features->storageBuffer16BitAccess) {
+        tl_storage16 = VkPhysicalDevice16BitStorageFeatures{};
+        tl_storage16.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES;
+        VkPhysicalDeviceFeatures2 feat2{};
+        feat2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+        feat2.pNext = &tl_storage16;
+        ::vkGetPhysicalDeviceFeatures2(physicalDevice, &feat2);
+        vk11_features->storageBuffer16BitAccess = tl_storage16.storageBuffer16BitAccess;
+        vk11_features->uniformAndStorageBuffer16BitAccess = tl_storage16.uniformAndStorageBuffer16BitAccess;
+        vk11_features->storagePushConstant16 = tl_storage16.storagePushConstant16;
+        vk11_features->storageInputOutput16 = tl_storage16.storageInputOutput16;
+    }
+
+    if (vk12_features != nullptr) {
+        if (!vk12_features->shaderFloat16 && !vk12_features->shaderInt8) {
+            tl_f16i8 = VkPhysicalDeviceShaderFloat16Int8Features{};
+            tl_f16i8.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES;
+            VkPhysicalDeviceVulkanMemoryModelFeatures mem_model{};
+            mem_model.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_MEMORY_MODEL_FEATURES;
+            tl_f16i8.pNext = &mem_model;
+            VkPhysicalDeviceFeatures2 feat2{};
+            feat2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+            feat2.pNext = &tl_f16i8;
+            ::vkGetPhysicalDeviceFeatures2(physicalDevice, &feat2);
+            vk12_features->shaderFloat16 = tl_f16i8.shaderFloat16;
+            vk12_features->shaderInt8 = tl_f16i8.shaderInt8;
+            vk12_features->vulkanMemoryModel = mem_model.vulkanMemoryModel;
+            vk12_features->vulkanMemoryModelDeviceScope = mem_model.vulkanMemoryModelDeviceScope;
+            vk12_features->vulkanMemoryModelAvailabilityVisibilityChains = mem_model.vulkanMemoryModelAvailabilityVisibilityChains;
+        }
+        if (props.apiVersion < VK_API_VERSION_1_2 || VULKAN_HPP_DEFAULT_DISPATCHER.vkGetBufferDeviceAddress == nullptr) {
+            vk12_features->bufferDeviceAddress = VK_FALSE;
+            vk12_features->bufferDeviceAddressCaptureReplay = VK_FALSE;
+            vk12_features->bufferDeviceAddressMultiDevice = VK_FALSE;
+        }
+        if (props.apiVersion < VK_API_VERSION_1_2 && vk11_features != nullptr) {
+            void * tail = vk12_features->pNext;
+            if (tl_f16i8.shaderFloat16 || tl_f16i8.shaderInt8) {
+                tl_f16i8.pNext = tail;
+                tail = &tl_f16i8;
+            }
+            if (tl_storage16.storageBuffer16BitAccess) {
+                tl_storage16.pNext = tail;
+                tail = &tl_storage16;
+            }
+            vk12_features->pNext = tail;
+        }
+    }
+}
