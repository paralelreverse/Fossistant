+inline PFN_vkGetPhysicalDeviceProperties2 & ggml_vk_real_get_props2() {
+    static PFN_vkGetPhysicalDeviceProperties2 pfn = nullptr;
+    return pfn;
+}
+
+inline VKAPI_ATTR void VKAPI_CALL ggml_vk_get_physical_device_properties2_hook(
+    VkPhysicalDevice physicalDevice,
+    VkPhysicalDeviceProperties2 * pProperties
+) {
+    PFN_vkGetPhysicalDeviceProperties2 real_fn = ggml_vk_real_get_props2();
+    if (real_fn != nullptr) {
+        real_fn(physicalDevice, pProperties);
+    } else {
+        ::vkGetPhysicalDeviceProperties2(physicalDevice, pProperties);
+    }
+    VkPhysicalDeviceSubgroupProperties * subgroup_props = nullptr;
+    VkPhysicalDeviceVulkan11Properties * vk11_props = nullptr;
+    for (VkBaseOutStructure * cur = reinterpret_cast<VkBaseOutStructure *>(pProperties->pNext); cur != nullptr; cur = cur->pNext) {
+        if (cur->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES) {
+            subgroup_props = reinterpret_cast<VkPhysicalDeviceSubgroupProperties *>(cur);
+        } else if (cur->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_PROPERTIES) {
+            vk11_props = reinterpret_cast<VkPhysicalDeviceVulkan11Properties *>(cur);
+        }
+    }
+    if (vk11_props != nullptr && subgroup_props != nullptr && vk11_props->subgroupSupportedStages == 0) {
+        vk11_props->subgroupSize = subgroup_props->subgroupSize;
+        vk11_props->subgroupSupportedStages = subgroup_props->supportedStages;
+        vk11_props->subgroupSupportedOperations = subgroup_props->supportedOperations;
+        vk11_props->subgroupQuadOperationsInAllStages = subgroup_props->quadOperationsInAllStages;
+    }
+}
